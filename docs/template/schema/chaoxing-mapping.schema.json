{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://course-template.local/schema/chaoxing-mapping.schema.json",
  "title": "通用课程站点 · 对接字段映射契约",
  "description": "约束 model/chaoxing-field-mapping.json 的结构，确保每个字段都标注方向与核验状态，防止把推测字段当成已确认接口。",
  "type": "object",
  "required": ["$meta", "authority_sources", "datasets", "responsibility_matrix"],
  "properties": {
    "datasets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "direction", "authority", "scope", "idempotency_key", "conflict_rule", "fields"],
        "properties": {
          "id": {"type": "string"},
          "direction": {"type": "string", "enum": ["outbound", "outbound-primary", "outbound-optional", "inbound-controlled", "inbound-aggregate", "redirect-only"]},
          "authority": {"type": "string", "description": "该类数据的唯一权威源"},
          "idempotency_key": {"type": "string", "description": "同步去重的稳定键"},
          "conflict_rule": {"type": "string", "description": "冲突时谁覆盖谁、差异如何上报"},
          "fields": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["canonical", "type", "chaoxing_label", "chaoxing_api_field", "transform", "direction", "required", "verification"],
              "properties": {
                "canonical": {"type": "string"},
                "type": {"type": "string"},
                "chaoxing_label": {"type": "string", "description": "平台界面/模板中可核验的字段名或功能名"},
                "chaoxing_api_field": {"type": ["string", "null"], "description": "实际接口字段名；未取得校方接口文档时必须为 null"},
                "transform": {"type": "string"},
                "direction": {"type": "string", "enum": ["out", "in", "internal", "config"]},
                "required": {"type": "boolean"},
                "verification": {"type": "string", "description": "包含『已核验』或『待核验』；混合状态须写明哪些部分待核验"},
                "evidence": {"type": "string"},
                "notes": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "responsibility_matrix": {
      "type": "array",
      "items": {
        "type": "object", "required": ["capability", "site", "chaoxing", "duplicate_risk", "rule"],
        "properties": {
          "capability": {"type": "string"}, "site": {"type": "string"},
          "chaoxing": {"type": "string"},
          "duplicate_risk": {"type": "string", "enum": ["无", "低", "中", "高"]},
          "rule": {"type": "string"}
        }
      }
    }
  }
}
